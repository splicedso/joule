#!/bin/sh
# Runs inside the image at build time: pin llama.cpp and Fabric, so a node's numbers are the notes' numbers.
set -e
systemctl enable spliced-clock spliced-power-log spliced-fabric
mkdir -p /var/lib/spliced/models /etc/spliced /opt
# llama.cpp at the pinned commit, Vulkan build (the toolchain for this is the build host's job; the commit is the contract)
echo "620d2225c" > /opt/llama.cpp.pin
# Fabric at a tag (vendored into mkosi.extra/opt/fabric by the build script before mkosi runs)
echo "image built $(date -u +%FT%TZ)" > /etc/spliced/image-id
