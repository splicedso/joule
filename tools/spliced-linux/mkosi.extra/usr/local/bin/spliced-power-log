#!/bin/sh
# Append package power (W), active shader clock (MHz), GPU busy (%) and every hwmon temperature (C) every N s.
OUT="$1"; N="${2:-10}"
D=$(ls -d /sys/class/drm/card*/device | head -1)
HW=$(ls -d "$D"/hwmon/hwmon* | head -1)
[ -f "$OUT" ] || echo "epoch,package_w,sclk_mhz,busy_pct,temps_c" >> "$OUT"
while true; do
  P=$(cat "$HW/power1_average" 2>/dev/null || echo 0); P=$(echo "scale=1; $P/1000000" | bc)
  C=$(grep '\*' "$D/pp_dpm_sclk" | grep -o '[0-9]*Mhz' | tr -d 'Mhz')
  B=$(cat "$D/gpu_busy_percent" 2>/dev/null || echo 0)
  T=$(for f in /sys/class/hwmon/hwmon*/temp*_input; do echo "scale=1; $(cat $f)/1000" | bc; done | tr '\n' ' ')
  echo "$(date +%s),$P,$C,$B,$T" >> "$OUT"
  sleep "$N"
done
