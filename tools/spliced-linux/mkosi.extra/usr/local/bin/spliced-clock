#!/bin/sh
# Cap the amdgpu shader clock through the OD table (the control that works on gfx1151, results/halo-clockcap.md)
# and verify under a short load that the active clock stays at the cap. Exits non-zero if it does not.
set -e
MHZ="${2:-1800}"
D=$(ls -d /sys/class/drm/card*/device | head -1)
case "$1" in
  cap)
    echo manual > "$D/power_dpm_force_performance_level"
    echo "s 1 $MHZ" > "$D/pp_od_clk_voltage"
    echo c > "$D/pp_od_clk_voltage"
    # verify: sample the active clock for 5 s while a small compute load runs
    ( python3 -c "import time; x=[i*i for i in range(10**6)]; time.sleep(5)" & ) ; sleep 1
    MAX=0; for i in $(seq 1 8); do C=$(grep '\*' "$D/pp_dpm_sclk" | grep -o '[0-9]*Mhz' | tr -d 'Mhz'); [ "$C" -gt "$MAX" ] && MAX=$C; sleep 0.5; done
    echo "cap $MHZ MHz, active max $MAX MHz"; [ "$MAX" -le "$MHZ" ]
    ;;
  auto)
    echo r > "$D/pp_od_clk_voltage"; echo c > "$D/pp_od_clk_voltage"; echo auto > "$D/power_dpm_force_performance_level"; echo "auto" ;;
  *) echo "usage: spliced-clock cap [MHz] | auto"; exit 2 ;;
esac
